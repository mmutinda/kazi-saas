DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kazi

JWT_SECRET=kazi-super-secret-jwt-key-change-in-production

ADMIN_EMAIL=admin@kazi.co.ke
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Kazi Admin

PORT=8080

# CDP: attach to a running browser instead of launching headless Chrome.
# Launch Edge with:
#   /Applications/Microsoft\ Edge.app/Contents/MacOS/Microsoft\ Edge \
#     --remote-debugging-port=9222 --user-data-dir=/tmp/edge-kazi
# Then log in to X.com / LinkedIn / Facebook in that window.
CDP_URL=http://127.0.0.1:9222

# Anthropic API key — used to enrich scraped jobs with Claude (title cleanup,
# county inference, salary extraction, is_job_post filtering).
# Get one at https://console.anthropic.com/settings/keys
# Leave empty to skip enrichment and fall back to keyword-based inference.
ANTHROPIC_API_KEY=
